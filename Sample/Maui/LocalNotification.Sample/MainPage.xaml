<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocalNotification.Sample.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,20"
            Spacing="18">

            <Label
                FontAttributes="Bold"
                FontSize="24"
                HorizontalOptions="Center"
                Text="Notifications Sample" />

            <Label
                HorizontalTextAlignment="Center"
                Text="Send local notifications, schedule reminders, and configure geofence notifications." />

            <Button
                Clicked="ButtonRequestPermissions_Clicked"
                HorizontalOptions="Center"
                Text="Request Notification and Location Permissions" />

            <Border Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="12">
                    <Label FontAttributes="Bold" Text="Local Notification" />

                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" HorizontalOptions="Center">
                        <DatePicker x:Name="NotifyDatePicker" Grid.Column="0" Format="d" />
                        <TimePicker x:Name="NotifyTimePicker" Grid.Column="1" Format="t" />
                        <Switch x:Name="UseNotifyTimeSwitch" Grid.Column="2" IsToggled="false" />
                    </Grid>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="Repeat next day at same time" VerticalOptions="Center" />
                        <Switch x:Name="RepeatSwitch" IsToggled="false" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="Display alert when notification is received" VerticalOptions="Center" />
                        <Switch x:Name="CustomAlert" IsToggled="false" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="Play sound in foreground" VerticalOptions="Center" />
                        <Switch x:Name="ForegroundSound" IsToggled="false" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="Use custom sound" VerticalOptions="Center" />
                        <Switch x:Name="CustomSoundSwitch" IsToggled="false" />
                    </HorizontalStackLayout>

                    <Label HorizontalOptions="Center" Text="On Android &gt;= 26, use NotificationChannel to set sound." />

                    <Button
                        Clicked="Button_Clicked"
                        HorizontalOptions="Center"
                        Text="Send Local Notification" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="12">
                    <Label FontAttributes="Bold" Text="Location Notification" />

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Latitude" VerticalOptions="Center" />
                        <Entry x:Name="LatitudeEntry" Grid.Row="0" Grid.Column="1" Keyboard="Numeric" Text="-37.003578276665095" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Longitude" VerticalOptions="Center" />
                        <Entry x:Name="LongitudeEntry" Grid.Row="1" Grid.Column="1" Keyboard="Numeric" Text="174.78484574983338" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Radius (m)" VerticalOptions="Center" />
                        <Entry x:Name="RadiusEntry" Grid.Row="2" Grid.Column="1" Keyboard="Numeric" Text="100" />
                    </Grid>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="Notify on entry" VerticalOptions="Center" />
                        <Switch x:Name="NotifyOnEntrySwitch" IsToggled="true" />
                        <Label Text="Notify on exit" VerticalOptions="Center" />
                        <Switch x:Name="NotifyOnExitSwitch" IsToggled="true" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="Repeat geofence" VerticalOptions="Center" />
                        <Switch x:Name="RepeatGeofenceSwitch" IsToggled="true" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Button Clicked="ButtonUseCurrentLocation_Clicked" Text="Use Current Location" />
                        <Button Clicked="ButtonCreateGeofence_Clicked" Text="Create Location Notification" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label FontAttributes="Bold" Text="Output" />
            <Editor x:Name="TestFileText" IsReadOnly="true" AutoSize="TextChanges" HeightRequest="160" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
